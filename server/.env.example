NODE_ENV=development
PORT=3333
HOST=0.0.0.0
DATABASE_URL=postgres://neurobloom:change_me@localhost:5432/neurobloom
JWT_SECRET=replace_with_a_random_secret_at_least_32_chars
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500
SESSION_COOKIE_SAME_SITE=lax
TRUST_PROXY=0
# Em produção: NODE_ENV=production, FRONTEND_ORIGIN=https://seu-site, TRUST_PROXY=1 (proxy conhecido).
# Prefira frontend e /api no mesmo domínio. Acesso direto entre sites exige SameSite=none/HTTPS,
# mas navegadores que bloqueiam cookies de terceiros podem impedir sessões nesse modo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NeuroBloom <nao-responda@example.com>
PAGBANK_TOKEN=
PAGBANK_WEBHOOK_SECRET=
# Dispositivos recebem seu segredo individual pela rota device-enrollment.
